# Copy to .env.local for local work. On Vercel, set these under
# Project → Settings → Environment Variables. Never commit real keys.
GEMINI_API_KEY=your-key-here
LLM_MODEL=gemini-3.6-flash
# Comma-separated light models: they write the answer text and back up the main model
LLM_FALLBACK_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Optional limits (defaults shown)
MAX_QUESTIONS_PER_DAY=1500
MAX_QUESTIONS_PER_VISITOR_PER_HOUR=20
